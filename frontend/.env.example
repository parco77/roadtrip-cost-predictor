# Origin of the deployed API, with no trailing slash and no /api suffix - src/api.js adds
# the path. Copy this file to .env.local to point a local `npm run dev` at a remote backend.
#
# Leave it UNSET for normal local work: api.js then falls back to relative paths and
# vite.config.js proxies /api to 127.0.0.1:8000, which is one less thing to keep in sync.
#
# On Vercel this is set in the project's Environment Variables, not in a committed file.
# Vite inlines it at build time, so changing it there needs a redeploy to take effect.
VITE_API_URL=https://roadtrip-cost-api.onrender.com
